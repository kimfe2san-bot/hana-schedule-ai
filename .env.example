# =============================================
# Google OAuth (Google Cloud Console에서 발급)
# =============================================
GOOGLE_CLIENT_ID=여기에_구글_클라이언트_ID
GOOGLE_CLIENT_SECRET=여기에_구글_클라이언트_시크릿

# =============================================
# NextAuth
# =============================================
# 로컬 개발: http://localhost:3000
# Vercel 배포 후: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=여기에_랜덤_시크릿_키_입력

# =============================================
# Supabase 데이터베이스 (supabase.com에서 발급)
# Settings > Database > Connection string
# =============================================
# Transaction pooler (API 라우트용 - 6543 포트)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (마이그레이션용 - 5432 포트)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# =============================================
# Anthropic (console.anthropic.com에서 발급)
# =============================================
ANTHROPIC_API_KEY=여기에_앤트로픽_API_키
